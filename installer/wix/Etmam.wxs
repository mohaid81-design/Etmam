<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Real-MSI counterpart to ..\EtmamSetup.iss (Inno Setup, still the primary EXE installer).
    Mirrors the same payload/behavior: self-contained single-file publish-release output,
    Api subfolder, Cairo font install, Start Menu + Desktop shortcuts, upgrade-in-place.
    UpgradeCode is intentionally different from the Inno AppId - they're separate installer
    technologies and can't detect/replace each other; each just needs its own stable GUID
    across versions. Do not change UpgradeCode once this MSI is distributed.
  -->
  <Package Name="Etmam"
           Manufacturer="Etmam"
           Version="$(var.ProductVersion)"
           UpgradeCode="B33F1330-8C8A-4BFE-A715-13AC794E1FD1"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Keywords="Installer" Description="Etmam Projects Management System Setup" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="EtmamIcon.ico" SourceFile="..\..\Etmam\Resources\etmam.ico" />
    <Property Id="ARPPRODUCTICON" Value="EtmamIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Etmam">
        <Directory Id="ApiFolder" Name="Api" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="Etmam" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="FontsFolder" />

    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <Component Id="EtmamExe" Guid="6C6E9A3E-7A19-4E4F-9C2D-3E7A5B1F2A01">
        <File Id="EtmamExeFile" Source="..\..\publish-release\Etmam.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                     Directory="AppProgramMenuFolder"
                     Name="Etmam"
                     WorkingDirectory="INSTALLFOLDER"
                     Icon="EtmamIcon.ico"
                     Advertise="no" />
          <Shortcut Id="DesktopShortcut"
                     Directory="DesktopFolder"
                     Name="Etmam"
                     WorkingDirectory="INSTALLFOLDER"
                     Icon="EtmamIcon.ico"
                     Advertise="no" />
        </File>
      </Component>
      <Component Id="EtmamDllConfig" Guid="9B6E0F0D-9A2F-4F0B-8B7E-2C8B9F0A0A02">
        <File Id="EtmamDllConfigFile" Source="..\..\publish-release\Etmam.dll.config" KeyPath="yes" />
      </Component>
      <Component Id="DataDllConfig" Guid="4C6C6B2A-1D3E-4B7B-9F2C-6A1E4B2C0A03">
        <File Id="DataDllConfigFile" Source="..\..\publish-release\Data.dll.config" KeyPath="yes" />
      </Component>
      <!-- Start Menu uninstall entry -->
      <Component Id="UninstallShortcut" Guid="2A8E4B6C-3F1D-4A9E-8C5B-7D2E4F6A0A04">
        <Shortcut Id="UninstallStartMenuShortcut"
                   Directory="AppProgramMenuFolder"
                   Name="Uninstall Etmam"
                   Target="[System64Folder]msiexec.exe"
                   Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKCU" Key="Software\Etmam\Etmam" Name="UninstallShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ApiComponents" Directory="ApiFolder">
      <Component Id="ApiExe" Guid="7D3E5A1C-2B4F-4E8A-9D6C-1A3B5C7E0A05">
        <File Id="ApiExeFile" Source="..\..\publish-release\Api\Api.exe" KeyPath="yes" />
      </Component>
      <Component Id="ApiAppsettings" Guid="1E4F6B2D-3C5A-4F9B-8E7D-2B4C6D8F0A06">
        <File Id="ApiAppsettingsFile" Source="..\..\publish-release\Api\appsettings.json" KeyPath="yes" />
      </Component>
      <!-- aspnetcorev2_inprocess.dll (IIS in-process hosting module - unused, Api runs
           self-hosted under Kestrel, never behind IIS) and Microsoft.Data.SqlClient.SNI.dll
           (native SNI - confirmed unneeded: a real SQL query against UsersList succeeded with
           neither file present, IncludeNativeLibrariesForSelfExtract bundles what's actually
           needed straight into Api.exe) used to ship here as loose files from an earlier publish
           invocation. Current `dotnet publish` (self-contained, PublishSingleFile,
           IncludeNativeLibrariesForSelfExtract) doesn't produce them at all, so they were
           dropped from this component group rather than left as stale hardcoded requirements. -->
    </ComponentGroup>

    <!--
      Cairo variable font, installed as a real OS-level font (matches EtmamSetup.iss's
      FontInstall behavior) via MSI's native File/@FontTitle registration - no custom action
      needed, Windows Installer handles font registry entries + font-cache refresh itself.
      Permanent="yes": never remove a shared system font on uninstall, matching the Inno
      script's uninsneveruninstall flag.
    -->
    <ComponentGroup Id="FontComponents" Directory="FontsFolder">
      <Component Id="CairoFont" Guid="5C7D9E5A-6F8D-4C2E-9B0A-5E7F9A0B0A09" Permanent="yes">
        <File Id="CairoFontFile"
              Source="..\..\Etmam\Resources\Fonts\Cairo-VariableFont.ttf"
              KeyPath="yes"
              FontTitle="Cairo" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Etmam" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="ApiComponents" />
      <ComponentGroupRef Id="FontComponents" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
