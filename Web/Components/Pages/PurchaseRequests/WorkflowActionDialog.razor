@using MudBlazor

<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_comment" Label="ملاحظة (اختياري)" Variant="Variant.Outlined" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">إلغاء</MudButton>
        <MudButton Color="@(IsApprove ? Color.Success : Color.Error)" Variant="Variant.Filled" OnClick="Confirm" Disabled="_busy">
            @Title
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int PurchaseRequestId { get; set; }

    /// <summary>true = Approve, false = Reject.</summary>
    [Parameter]
    public bool IsApprove { get; set; }

    [Inject]
    private EtmamApiClient Api { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    private string Title => IsApprove ? "اعتماد" : "رفض";
    private string? _comment;
    private bool _busy;

    private async Task Confirm()
    {
        _busy = true;
        try
        {
            if (IsApprove)
                await Api.ApprovePurchaseRequestAsync(PurchaseRequestId, _comment);
            else
                await Api.RejectPurchaseRequestAsync(PurchaseRequestId, _comment);

            Snackbar.Add($"تم {Title} بنجاح ✓", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"تعذر {Title}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
