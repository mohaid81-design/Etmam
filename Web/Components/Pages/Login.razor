@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@inject NavigationManager Nav

@** Deliberately NOT @rendermode InteractiveServer: signing in must write an auth cookie via a
     normal HTTP response (HttpContext.SignInAsync), which an already-connected interactive
     circuit cannot do. So this stays a static SSR page whose <form> posts straight to the plain
     /account/login endpoint in Program.cs instead of calling a Blazor event handler. **@

<PageTitle>تسجيل الدخول - إتمام</PageTitle>

<MudCard Elevation="4" Class="pa-4" Style="width: 100%; max-width: 420px;">
    <MudCardContent>
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1">إتمام</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-4">
            نظام إدارة المشاريع
        </MudText>

        @if (_showError)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">اسم المستخدم أو كلمة المرور غير صحيحة</MudAlert>
        }

        <form method="post" action="/account/login">
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <MudTextField T="string" Name="username" Label="اسم المستخدم" Variant="Variant.Outlined" Class="mb-4" Required="true" />
            <MudTextField T="string" Name="password" Label="كلمة المرور" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" Required="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
                دخول
            </MudButton>
        </form>
    </MudCardContent>
</MudCard>

@code {
    private bool _showError;
    private string? _returnUrl;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (string.IsNullOrEmpty(uri.Query))
            return;

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _showError = query.TryGetValue("error", out var error) && error == "1";
        _returnUrl = query.TryGetValue("returnUrl", out var ru) ? ru.ToString() : null;
    }
}
