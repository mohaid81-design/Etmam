<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>etmam-web-9a2c7e5d-1f4b-4c3a-8e6d-2b7f9c4a5e1b</UserSecretsId>
  </PropertyGroup>

  <!-- Explicit exclude: protects against concurrent agent builds that override
       BaseIntermediateOutputPath to a sibling subfolder under obj\ (e.g. obj\_agentX\),
       which narrows the SDK's default item-exclude glob so it no longer covers the
       whole obj\ tree, letting other agents' generated obj\_agentY\**\*.cs leak into
       this compile (CS0579 duplicate AssemblyInfo attribute errors). -->
  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
  </ItemGroup>

</Project>
