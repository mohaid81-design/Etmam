<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\etmam.ico</ApplicationIcon>
    <!-- Read by Application.ProductVersion at runtime (Gui/MainPage/frmStart.cs's update-gate
         check, SettingsForm.cs's About panel). Bump this together with ..\installer\EtmamSetup.iss's
         MyAppVersion when cutting a release - the two aren't auto-linked (Inno's preprocessor
         can't read an MSBuild property, and vice versa), so this is a manual two-file sync point. -->
    <Version>1.3.1</Version>
    <!-- Without this, the SDK appends "+<git-commit-hash>" to Application.ProductVersion (since
         this is a git repo), which breaks frmStart.cs's System.Version.TryParse comparison and
         looks wrong in SettingsForm.cs's About panel. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

