@using MudBlazor

<MudDialog>
    <TitleContent>@(_isEdit ? "تعديل مشروع" : "مشروع جديد")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Num" Label="رقم المشروع" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_model.Name" Label="اسم المشروع" Variant="Variant.Outlined" Required="true" Class="mb-3" />
            <MudTextField @bind-Value="_model.Description" Label="الوصف" Variant="Variant.Outlined" Lines="3" Class="mb-3" />
            <MudSelect T="int?" @bind-Value="_model.CLId" Label="المالك/العميل" Variant="Variant.Outlined" Clearable="true" Class="mb-3">
                @foreach (var client in _clients)
                {
                    <MudSelectItem T="int?" Value="client.Id">@client.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int?" @bind-Value="_model.CSTId" Label="الاستشاري" Variant="Variant.Outlined" Clearable="true" Class="mb-3">
                @foreach (var consultant in _consultants)
                {
                    <MudSelectItem T="int?" Value="consultant.Id">@consultant.Name</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="_model.ContractDate" Label="تاريخ العقد" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_model.ContractAmount" Label="قيمة العقد" Variant="Variant.Outlined" Format="N2" Class="mb-3" />
            <MudNumericField @bind-Value="_model.AdvancePaymentAmount" Label="قيمة الدفعة المقدمة" Variant="Variant.Outlined" Format="N2" Class="mb-3" />
            <MudNumericField @bind-Value="_model.AdvancePaymentPercent" Label="نسبة الدفعة المقدمة %" Variant="Variant.Outlined" Format="N2" Class="mb-3" />
            <MudNumericField @bind-Value="_model.RetentionPercent" Label="نسبة الضمان %" Variant="Variant.Outlined" Format="N2" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">إلغاء</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">حفظ</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int? ProjectId { get; set; }

    [Inject]
    private EtmamApiClient Api { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private List<StakeholderLookupDto> _clients = [];
    private List<StakeholderLookupDto> _consultants = [];
    private bool _isEdit;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _clients = await Api.GetProjectClientsAsync();
        _consultants = await Api.GetProjectConsultantsAsync();

        _isEdit = ProjectId is > 0;
        if (_isEdit)
        {
            var dto = await Api.GetProjectAsync(ProjectId!.Value);
            if (dto is not null)
            {
                _model.Num = dto.Num;
                _model.Name = dto.Name;
                _model.Description = dto.Description;
                _model.CLId = dto.CLId;
                _model.CSTId = dto.CSTId;
                _model.ContractDate = dto.ContractDate;
                _model.ContractAmount = dto.ContractAmount;
                _model.AdvancePaymentAmount = dto.AdvancePaymentAmount;
                _model.AdvancePaymentPercent = dto.AdvancePaymentPercent;
                _model.RetentionPercent = dto.RetentionPercent;
            }
        }
    }

    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        _saving = true;
        try
        {
            if (_isEdit)
            {
                await Api.UpdateProjectAsync(ProjectId!.Value, new ProjectUpdateRequest
                {
                    Num = _model.Num,
                    Name = _model.Name,
                    Description = _model.Description,
                    CLId = _model.CLId,
                    CSTId = _model.CSTId,
                    ContractDate = _model.ContractDate,
                    ContractAmount = _model.ContractAmount,
                    AdvancePaymentAmount = _model.AdvancePaymentAmount,
                    AdvancePaymentPercent = _model.AdvancePaymentPercent,
                    RetentionPercent = _model.RetentionPercent,
                });
            }
            else
            {
                await Api.CreateProjectAsync(new ProjectCreateRequest
                {
                    Num = _model.Num,
                    Name = _model.Name,
                    Description = _model.Description,
                    CLId = _model.CLId,
                    CSTId = _model.CSTId,
                    ContractDate = _model.ContractDate,
                    ContractAmount = _model.ContractAmount,
                    AdvancePaymentAmount = _model.AdvancePaymentAmount,
                    AdvancePaymentPercent = _model.AdvancePaymentPercent,
                    RetentionPercent = _model.RetentionPercent,
                });
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"تعذر الحفظ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class FormModel
    {
        public string? Num { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public int? CLId { get; set; }
        public int? CSTId { get; set; }
        public DateTime? ContractDate { get; set; }
        public decimal? ContractAmount { get; set; }
        public decimal? AdvancePaymentAmount { get; set; }
        public decimal? AdvancePaymentPercent { get; set; }
        public decimal? RetentionPercent { get; set; }
    }
}
