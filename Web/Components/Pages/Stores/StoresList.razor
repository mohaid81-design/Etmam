@page "/inventory/stores"
@rendermode InteractiveServer
@inject EtmamApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>المخازن - إتمام</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">المخازن</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        مخزن جديد
    </MudButton>
</MudStack>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Placeholder="بحث بالاسم..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Class="mb-4" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else
{
    <MudTable Items="@FilteredStores" Hover="true" Bordered="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>الكود</MudTh>
            <MudTh>الاسم</MudTh>
            <MudTh>المشروع</MudTh>
            <MudTh>نشط</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="الكود">@context.Code</MudTd>
            <MudTd DataLabel="الاسم">@context.Name</MudTd>
            <MudTd DataLabel="المشروع">@context.ProjectName</MudTd>
            <MudTd DataLabel="نشط">
                @if (context.IsActive == true)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" Size="Size.Small" />
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context.Id))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteStore(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>لا توجد مخازن.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<StoreDto> _stores = [];
    private bool _loading = true;
    private string? _loadError;
    private string _search = "";

    private IEnumerable<StoreDto> FilteredStores =>
        string.IsNullOrWhiteSpace(_search)
            ? _stores
            : _stores.Where(s => (s.Name ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _stores = await Api.GetStoresAsync();
        }
        catch (HttpRequestException ex)
        {
            _loadError = $"تعذر تحميل المخازن من الخادم: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchChanged(string value) => _search = value;

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<StoreEditDialog> { { x => x.StoreId, null } };
        var dialog = await DialogService.ShowAsync<StoreEditDialog>("مخزن جديد", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenEditDialog(int id)
    {
        var parameters = new DialogParameters<StoreEditDialog> { { x => x.StoreId, id } };
        var dialog = await DialogService.ShowAsync<StoreEditDialog>("تعديل مخزن", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteStore(StoreDto store)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "تأكيد الحذف",
            $"هل تريد حذف المخزن \"{store.Name}\"؟",
            yesText: "حذف", cancelText: "إلغاء");
        if (confirmed != true)
            return;

        try
        {
            await Api.DeleteStoreAsync(store.Id);
            Snackbar.Add("تم حذف المخزن.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"تعذر الحذف: {ex.Message}", Severity.Error);
        }
    }
}
