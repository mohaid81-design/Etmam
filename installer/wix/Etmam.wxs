<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Real-MSI counterpart to ..\EtmamSetup.iss (Inno Setup, still the primary EXE installer).
    Mirrors the same payload/behavior: self-contained folder publish-release output (NOT
    single-file - see EtmamSetup.iss's [Files] comment: PublishSingleFile broke every DB
    connection because Microsoft.Data.SqlClient's native SNI loader can't resolve its own
    DLL from inside a single-file bundle), Api subfolder (same fix - also folder-published,
    not single-file), Cairo font install, Start Menu + Desktop shortcuts, upgrade-in-place.
    UpgradeCode is intentionally different from the Inno AppId - they're separate installer
    technologies and can't detect/replace each other; each just needs its own stable GUID
    across versions. Do not change UpgradeCode once this MSI is distributed.
  -->
  <Package Name="Etmam"
           Manufacturer="Etmam"
           Version="$(var.ProductVersion)"
           UpgradeCode="B33F1330-8C8A-4BFE-A715-13AC794E1FD1"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Keywords="Installer" Description="Etmam Projects Management System Setup" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="EtmamIcon.ico" SourceFile="..\..\Etmam\Resources\etmam.ico" />
    <Property Id="ARPPRODUCTICON" Value="EtmamIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Etmam">
        <Directory Id="ApiFolder" Name="Api" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="Etmam" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="FontsFolder" />

    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <!-- Whole publish-release folder (runtime + all its loose DLLs, deps.json,
           runtimeconfig.json, locale satellite folders, etc.) except the Api subtree
           (harvested separately below into ApiFolder) and .pdb debug symbols, which are
           intentionally excluded from the end-user package. -->
      <Files Include="..\..\publish-release\**">
        <Exclude Files="..\..\publish-release\**\*.pdb" />
        <Exclude Files="..\..\publish-release\Api\**" />
      </Files>

      <!-- Shortcuts target the installed path directly rather than hanging off a specific
           harvested File element, since Files auto-harvesting doesn't let us pick the Id
           of the Etmam.exe File it generates. -->
      <Component Id="StartMenuShortcut" Guid="EA9A318E-63BA-4327-89CE-47E5B61CFF63">
        <Shortcut Id="StartMenuShortcutFile"
                   Directory="AppProgramMenuFolder"
                   Name="Etmam"
                   WorkingDirectory="INSTALLFOLDER"
                   Icon="EtmamIcon.ico"
                   Advertise="no"
                   Target="[INSTALLFOLDER]Etmam.exe" />
        <RegistryValue Root="HKCU" Key="Software\Etmam\Etmam" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Guid="4896992E-4693-4984-A640-EEAC66100623">
        <Shortcut Id="DesktopShortcutFile"
                   Directory="DesktopFolder"
                   Name="Etmam"
                   WorkingDirectory="INSTALLFOLDER"
                   Icon="EtmamIcon.ico"
                   Advertise="no"
                   Target="[INSTALLFOLDER]Etmam.exe" />
        <RegistryValue Root="HKCU" Key="Software\Etmam\Etmam" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- Start Menu uninstall entry -->
      <Component Id="UninstallShortcut" Guid="2A8E4B6C-3F1D-4A9E-8C5B-7D2E4F6A0A04">
        <Shortcut Id="UninstallStartMenuShortcut"
                   Directory="AppProgramMenuFolder"
                   Name="Uninstall Etmam"
                   Target="[System64Folder]msiexec.exe"
                   Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKCU" Key="Software\Etmam\Etmam" Name="UninstallShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ApiComponents" Directory="ApiFolder">
      <!-- Whole Api publish-release subfolder (Api.dll, deps.json, runtimeconfig.json, every
           loose runtime/dependency DLL including Microsoft.Data.SqlClient.SNI.dll, locale
           satellite folders, etc.) - NOT just Api.exe + appsettings.json as this used to
           hardcode. That old assumption (Api still single-file, IncludeNativeLibrariesForSelfExtract
           bundling everything needed straight into Api.exe) was wrong: Api.exe hit the exact same
           SNI DllNotFoundException as Etmam.exe once actually exercised through a real
           /api/auth/login call (Assembly.Location empty inside a single-file bundle), so Api is
           now folder-published too (see EtmamSetup.iss's [Files] comment) and needs its whole
           output tree harvested the same way MainComponents does above - hardcoding 2 files here
           silently dropped Api.dll itself from the package, which surfaces at runtime as "The
           application to execute does not exist: '...\Api\Api.dll'" since Api.exe is just the
           native apphost stub without it. Excludes mirror EtmamSetup.iss's Api Source line:
           .pdb symbols, the IIS-only web.config, BuildHost-* (Roslyn design-time noise, not
           needed at runtime), and the dev-only appsettings file. -->
      <Files Include="..\..\publish-release\Api\**">
        <Exclude Files="..\..\publish-release\Api\**\*.pdb" />
        <Exclude Files="..\..\publish-release\Api\web.config" />
        <Exclude Files="..\..\publish-release\Api\BuildHost-net472\**" />
        <Exclude Files="..\..\publish-release\Api\BuildHost-netcore\**" />
        <Exclude Files="..\..\publish-release\Api\appsettings.Development.json" />
      </Files>
    </ComponentGroup>

    <!--
      Cairo variable font, installed as a real OS-level font (matches EtmamSetup.iss's
      FontInstall behavior) via MSI's native File/@FontTitle registration - no custom action
      needed, Windows Installer handles font registry entries + font-cache refresh itself.
      Permanent="yes": never remove a shared system font on uninstall, matching the Inno
      script's uninsneveruninstall flag.
    -->
    <ComponentGroup Id="FontComponents" Directory="FontsFolder">
      <Component Id="CairoFont" Guid="5C7D9E5A-6F8D-4C2E-9B0A-5E7F9A0B0A09" Permanent="yes">
        <File Id="CairoFontFile"
              Source="..\..\Etmam\Resources\Fonts\Cairo-VariableFont.ttf"
              KeyPath="yes"
              FontTitle="Cairo" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Etmam" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="ApiComponents" />
      <ComponentGroupRef Id="FontComponents" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
